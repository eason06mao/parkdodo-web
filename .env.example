# 複製成 .env.local 後再填值；.env.local 不會進 Git。
# 金鑰、密碼只放在 .env.local 或伺服器環境變數，不要貼到聊天、文件或程式碼裡。

# 本機 PostgreSQL（docker-compose.yml）
DATABASE_URL=postgres://parkdodo:parkdodo_dev_only@127.0.0.1:5432/parkdodo_dev

# 功能開關
NEXT_PUBLIC_FEATURE_CASH_KIOSK=false

# 統一金流 PAYUNi 沙箱（拿到測試商店後再填）
PAYUNI_ENV=sandbox
PAYUNI_MER_ID=
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=
