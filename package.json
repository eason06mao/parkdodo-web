{
  "name": "parkdodo-web",
  "version": "0.1.0",
  "private": true,
  "description": "ParkDodo V2 營運後台（Mock 資料版）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "node scripts/db.mjs up",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:test": "node scripts/db.mjs test",
    "db:reset": "node scripts/db.mjs reset",
    "test:payuni": "tsx --test tests/payuni/crypto.test.ts",
    "payuni:check": "tsx scripts/payuni-check.ts",
    "test:invoice": "tsx --test tests/invoice/invoice.test.ts",
    "test:billing": "tsx --test tests/billing/fee.test.ts",
    "test:roles": "tsx --test tests/roles/roles.test.ts",
    "test:edge": "tsx --test tests/edge/edge.test.ts",
    "db:migrate:url": "node scripts/migrate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
